# ============================================================
# Tutor IA UPEC — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# ── Puerto del Frontend / Nginx ─────────────────────────────
FRONTEND_PORT=80

# ── Base de Datos (PostgreSQL + pgvector) ───────────────────
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=tutor_secure_password_2024
POSTGRES_DB=tutor_bd_upec

# ── Ollama (Motor de IA Local) ──────────────────────────────
# Estas variables las usa el backend internamente.
# No es necesario cambiarlas a menos que modifiques docker-compose.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ── Seguridad y Autenticación JWT ───────────────────────────
SECRET_KEY=cambiar-por-un-secreto-aleatorio-seguro-en-produccion
JWT_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173


# ── Google OAuth & APIs de IA ───────────────────────────────
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Correo SMTP (recuperación de contraseña) ────────────────
# Sin SMTP_HOST los códigos de recuperación no se envían.
# Gmail: smtp.gmail.com, puerto 587, starttls y una "contraseña de aplicación"
#        (https://myaccount.google.com/apppasswords, requiere verificación en 2 pasos).
# Outlook/Office 365: smtp.office365.com, puerto 587, starttls.
# SMTP_SECURITY: starttls (puerto 587) | ssl (puerto 465) | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AMY Tutor UPEC
SMTP_SECURITY=starttls
